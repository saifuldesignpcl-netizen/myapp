name: Build Flet Android APK

on:
  push:
    branches:
      - main
  workflow_dispatch: # এটি আপনাকে ম্যানুয়ালি ক্লিক করে APK বিল্ড করার সুবিধা দেবে

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up Java Development Kit (JDK)
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.22.x' # সাম্প্রতিক Flutter ভার্সন
          channel: 'stable'

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install flet openpyxl reportlab

      - name: Build APK with Flet
        run: |
          flet build apk

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: Cable-Quotation-App-APK
          path: build/apk/*.apk
